# Frontend Environment Variables
# Leave empty on one machine (Vite proxy forwards /api to http://localhost:8000).
# Set to http://<LINUX_IP>:8000 (e.g. http://192.168.1.50:8000) when the frontend runs on a different laptop.
VITE_API_URL=http://localhost:8000

# Set to "true" to run frontend with full simulated mock data without backend dependency
VITE_USE_MOCK=true
